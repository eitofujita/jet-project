<div class="mx-auto max-w-2xl">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold">フィード</h1>
    <%= link_to "すべての投稿", posts_path, class: "text-blue-600 hover:underline" %>
  </div>

  <% if @posts.any? %>
    <div class="space-y-8">
      <%= render @posts %>
    </div>
  <% else %>
    <div class="rounded-xl bg-white p-8 text-center shadow">
      <p class="mb-4">フィードに表示する投稿がありません。</p>
      <%= link_to "最初の投稿を作成", new_post_path, class: "text-blue-600 underline" %>
    </div>
  <% end %>
</div>
