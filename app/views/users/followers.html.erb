<div class="mx-auto max-w-2xl">
  <div class="mb-6">
    <%= link_to "← @#{@user.username}", user_path(@user), class: "text-blue-600 hover:underline" %>
    <h1 class="mt-3 text-2xl font-bold">Подписчики</h1>
  </div>

  <% if @users.any? %>
    <div class="space-y-4">
      <%= render partial: "user_card", collection: @users, as: :user %>
    </div>
  <% else %>
    <div class="rounded-xl bg-white p-8 text-center shadow-sm">
      <p>У этого пользователя пока нет подписчиков.</p>
    </div>
  <% end %>
</div>
