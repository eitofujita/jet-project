<article class="flex items-center justify-between gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <%= link_to user_path(user), class: "min-w-0 flex-1 hover:text-blue-600" do %>
    <h2 class="truncate text-lg font-semibold">@<%= user.username %></h2>
    <p class="mt-1 text-sm text-slate-600">
      Публикаций: <%= user.posts.size %> · Подписчиков: <%= user.followers.size %>
    </p>
  <% end %>

  <% if current_user != user %>
    <% if @followed_user_ids.include?(user.id) %>
      <%= button_to "Отписаться", user_follow_path(user), method: :delete, class: "rounded-lg border px-4 py-2 font-semibold" %>
    <% else %>
      <%= button_to "Подписаться", user_follow_path(user), method: :post, class: "rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white hover:bg-blue-700" %>
    <% end %>
  <% end %>
</article>
