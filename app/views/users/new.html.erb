<div class="mx-auto max-w-md rounded-xl bg-white p-8 shadow">
  <h1 class="mb-6 text-2xl font-bold">アカウント登録</h1>

  <%= form_with model: @user, class: "space-y-5" do |form| %>
    <% if @user.errors.any? %>
      <div class="rounded-lg bg-red-50 p-4 text-red-800" role="alert">
        <ul class="list-disc pl-5">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :username, "ユーザー名", class: "block font-medium" %>
      <%= form.text_field :username, required: true, autocomplete: "username", class: "mt-1 w-full rounded-lg border p-3" %>
    </div>
    <div>
      <%= form.label :email, "メールアドレス", class: "block font-medium" %>
      <%= form.email_field :email, required: true, autocomplete: "email", class: "mt-1 w-full rounded-lg border p-3" %>
    </div>
    <div>
      <%= form.label :password, "パスワード（8文字以上）", class: "block font-medium" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", class: "mt-1 w-full rounded-lg border p-3" %>
    </div>
    <div>
      <%= form.label :password_confirmation, "パスワード確認", class: "block font-medium" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "mt-1 w-full rounded-lg border p-3" %>
    </div>
    <%= form.submit "登録する", class: "w-full rounded-lg bg-blue-600 px-4 py-3 font-semibold text-white hover:bg-blue-700" %>
  <% end %>
</div>
