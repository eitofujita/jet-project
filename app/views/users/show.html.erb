<div class="mx-auto max-w-2xl">
  <header class="mb-8 rounded-xl bg-white p-6 shadow-sm">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold">@<%= @user.username %></h1>
        <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2 text-slate-600">
          <span>Публикаций: <%= @user.posts.size %></span>
          <%= link_to followers_user_path(@user), class: "hover:text-blue-600 hover:underline" do %>
            Подписчиков: <%= @user.followers.size %>
          <% end %>
          <%= link_to following_user_path(@user), class: "hover:text-blue-600 hover:underline" do %>
            Подписок: <%= @user.following.size %>
          <% end %>
        </div>
      </div>

      <% if current_user != @user %>
        <% if current_user.following.exists?(@user.id) %>
          <%= button_to "Отписаться", user_follow_path(@user), method: :delete, class: "rounded-lg border px-4 py-2 font-semibold" %>
        <% else %>
          <%= button_to "Подписаться", user_follow_path(@user), method: :post, class: "rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white" %>
        <% end %>
      <% end %>
    </div>
  </header>

  <div class="space-y-8">
    <%= render @posts %>
  </div>
</div>
