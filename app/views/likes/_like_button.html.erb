<div id="<%= dom_id(post, :like) %>" class="flex items-center gap-3">
  <% like = post.likes.find { |item| item.user_id == current_user.id } %>
  <% if like %>
    <%= button_to "♥ いいね解除", post_like_path(post), method: :delete, class: "font-semibold text-red-600" %>
  <% else %>
    <%= button_to "♡ いいね", post_like_path(post), method: :post, class: "font-semibold text-slate-700 hover:text-red-600" %>
  <% end %>
  <span><%= post.likes.size %>件</span>
</div>
