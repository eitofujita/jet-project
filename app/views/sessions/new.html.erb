<div class="mx-auto max-w-md rounded-xl bg-white p-8 shadow">
  <h1 class="mb-6 text-2xl font-bold">ログイン</h1>

  <%= form_with url: session_path, class: "space-y-5" do |form| %>
    <div>
      <%= form.label :email, "メールアドレス", class: "block font-medium" %>
      <%= form.email_field :email, required: true, autocomplete: "email", class: "mt-1 w-full rounded-lg border p-3" %>
    </div>
    <div>
      <%= form.label :password, "パスワード", class: "block font-medium" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", class: "mt-1 w-full rounded-lg border p-3" %>
    </div>
    <%= form.submit "ログイン", class: "w-full rounded-lg bg-blue-600 px-4 py-3 font-semibold text-white hover:bg-blue-700" %>
  <% end %>

  <p class="mt-6 text-center text-sm">
    アカウントをお持ちでない場合は<%= link_to "新規登録", new_user_path, class: "text-blue-600 underline" %>
  </p>
</div>
