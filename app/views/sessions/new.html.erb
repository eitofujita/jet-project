<div class="mx-auto max-w-md rounded-xl bg-white p-8 shadow">
  <h1 class="mb-6 text-2xl font-bold">Вход</h1>

  <%= form_with url: login_path, class: "space-y-5", data: { controller: "form-validation" } do |form| %>
    <div>
      <%= form.label :email, "Электронная почта", class: "block font-medium" %>
      <%= form.email_field :email, required: true, autocomplete: "email", class: "mt-1 w-full rounded-lg border p-3", data: { action: "invalid->form-validation#invalid input->form-validation#clear" } %>
    </div>
    <div>
      <%= form.label :password, "Пароль", class: "block font-medium" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", class: "mt-1 w-full rounded-lg border p-3", data: { action: "invalid->form-validation#invalid input->form-validation#clear" } %>
    </div>
    <%= form.submit "Войти", class: "w-full rounded-lg bg-blue-600 px-4 py-3 font-semibold text-white hover:bg-blue-700" %>
  <% end %>

  <p class="mt-6 text-center text-sm">
    Нет аккаунта? <%= link_to "Зарегистрироваться", signup_path, class: "text-blue-600 underline" %>
  </p>
</div>
