<div id="<%= dom_id(comment) %>" class="flex items-start justify-between gap-4 border-b py-3">
  <p class="whitespace-pre-wrap"><span class="font-semibold">@<%= comment.user.username %></span> <%= comment.body %></p>
  <% if policy(comment).destroy? %>
    <%= button_to "Удалить", post_comment_path(comment.post, comment), method: :delete, class: "text-sm text-red-600" %>
  <% end %>
</div>
