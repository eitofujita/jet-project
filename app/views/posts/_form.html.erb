<%= form_with model: post, class: "space-y-5" do |form| %>
  <% if post.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 text-red-800" role="alert">
      <ul class="list-disc pl-5">
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :image, "画像", class: "block font-medium" %>
    <%= form.file_field :image, accept: "image/jpeg,image/png,image/webp", required: !post.image.attached?, class: "mt-1 block w-full rounded-lg border bg-white p-3" %>
    <p class="mt-1 text-sm text-slate-500">JPEG、PNG、WebP形式・5MB以下</p>
  </div>

  <div>
    <%= form.label :caption, "本文", class: "block font-medium" %>
    <%= form.text_area :caption, maxlength: 2_200, rows: 5, class: "mt-1 w-full rounded-lg border p-3" %>
  </div>

  <%= form.submit class: "rounded-lg bg-blue-600 px-5 py-3 font-semibold text-white hover:bg-blue-700" %>
<% end %>
