<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "Mini Instagram" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Mini Instagram">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900">
    <header class="sticky top-0 z-10 border-b border-slate-200 bg-white">
      <nav class="mx-auto flex max-w-4xl items-center justify-between px-4 py-3" aria-label="Основная навигация">
        <%= link_to "Mini Instagram", root_path, class: "text-xl font-bold" %>
        <div class="flex items-center gap-4">
          <% if signed_in? %>
            <%= link_to "Лента", root_path, class: "hover:text-blue-600" %>
            <%= link_to "Все публикации", posts_path, class: "hover:text-blue-600" %>
            <%= link_to "Найти пользователей", users_path, class: "hover:text-blue-600" %>
            <%= link_to "Новая публикация", new_post_path, class: "rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white hover:bg-blue-700" %>
            <%= link_to current_user.username, user_path(current_user), class: "hover:text-blue-600" %>
            <%= button_to "Выйти", logout_path, method: :delete, class: "hover:text-red-600" %>
          <% else %>
            <%= link_to "Войти", login_path, class: "hover:text-blue-600" %>
            <%= link_to "Регистрация", signup_path, class: "rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white" %>
          <% end %>
        </div>
      </nav>
    </header>

    <main class="mx-auto w-full max-w-4xl px-4 py-8">
      <% if notice %>
        <p class="mb-6 rounded-lg bg-green-100 px-4 py-3 text-green-900" role="status"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="mb-6 rounded-lg bg-red-100 px-4 py-3 text-red-900" role="alert"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
